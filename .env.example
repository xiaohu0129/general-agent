# ===== 部署环境变量模板 =====
# 复制为 .env 后填写真实值；.env 不要提交到仓库。

# ---- 对外 HTTP 端口（浏览器访问 http://<主机IP>:HTTP_PORT）----
HTTP_PORT=8080

# ---- 真实 LLM（OpenAI 兼容端点）----
# 注意：代码会 POST {base_url}/v1/chat/completions，base_url 不要带 /v1 后缀
LLM_BASE_URL=https://your-openai-compatible-endpoint
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# ---- Embedding 端点（Skill 意图路由/向量检索用，OpenAI 兼容 POST {base_url}/v1/embeddings）----
# 留空则路由降级为仅规则匹配 + 全量工具兜底（启动 WARN）；方舟示例：
# EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=doubao-embedding-vision

# ---- 路由/embedding 调优（env 前缀 AGENT_，嵌套分隔符 __；下列值均与代码默认一致）----
# AGENT_EMBEDDING__BATCH_SIZE=64   # 索引构建时 embed_texts 分批请求批大小
# AGENT_ROUTING__CONTEXT_TURNS=3   # 路由拼接的最近对话轮数，0=关闭跨轮上下文
# AGENT_ROUTING__QUERY_REWRITE=true   # 按需 query 改写开关
# AGENT_ROUTING__MULTI_VECTOR=true    # 每-example 多向量索引开关
# AGENT_ROUTING__LLM_CONF_HIGH=0.7    # 兜底 LLM 高置信点名阈值
# AGENT_ROUTING__ARG_GUARD=true       # 缺参校验守卫开关
# AGENT_ROUTING__HYBRID=true          # BM25+向量混合检索开关
# AGENT_ROUTING__RRF_K=60             # RRF 融合常数
# AGENT_ROUTING__KEYWORD_TOP_K=10     # 关键词路返回数
# AGENT_ROUTING__CLARIFY_OPTIONS=true # 结构化澄清选项开关
# AGENT_ROUTING__CLARIFY_OPTION_MAX=4 # 澄清选项数量上限
# 指代词默认表在代码内维护，仅需整体覆盖时用 JSON 数组：
# AGENT_ROUTING__REFER_TERMS=["它","那个","这个","再来","继续"]

# ---- 外部 MySQL ----
# 若 MySQL 跑在宿主机上，HOST 填 host.docker.internal；若是远程实例填其 IP/域名
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=general_agent

# ---- Redis（单实例部署留空即可；多实例高可用才需要）----
REDIS_URL=
