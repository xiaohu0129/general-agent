# ===== 部署环境变量模板 =====
# 复制为 .env 后填写真实值；.env 不要提交到仓库。

# ---- 对外 HTTP 端口（浏览器访问 http://<主机IP>:HTTP_PORT）----
HTTP_PORT=8080

# ---- 真实 LLM（OpenAI 兼容端点）----
# 注意：代码会 POST {base_url}/v1/chat/completions，base_url 不要带 /v1 后缀
LLM_BASE_URL=https://your-openai-compatible-endpoint
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# ---- Embedding 端点（Skill 意图路由/向量检索用，OpenAI 兼容 POST {base_url}/v1/embeddings）----
# 留空则路由降级为仅规则匹配 + 全量工具兜底（启动 WARN）；方舟示例：
# EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=doubao-embedding-vision

# ---- 外部 MySQL ----
# 若 MySQL 跑在宿主机上，HOST 填 host.docker.internal；若是远程实例填其 IP/域名
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=general_agent

# ---- Redis（单实例部署留空即可；多实例高可用才需要）----
REDIS_URL=
